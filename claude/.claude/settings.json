{
  "model": "opus[1m]",
  "enabledPlugins": {},
  "extraKnownMarketplaces": {
    "tmux-status-dev": {
      "source": {
        "source": "git",
        "url": "https://github.com/haxybaxy/claude-tmux-status.git"
      }
    }
  },
  "skillOverrides": {
