ctrl - right: rift-cli execute workspace next
ctrl - left: rift-cli execute workspace prev

fn - h: rift-cli execute window focus left
fn - j: rift-cli execute window focus down
fn - k: rift-cli execute window focus up
fn - l: rift-cli execute window focus right

fn+shift-h: rift-cli execute layout move-node left
fn+shift-j: rift-cli execute layout move-node down
fn+shift-k: rift-cli execute layout move-node up
fn+shift-l: rift-cli execute layout move-node right

fn+ctrl+shift-h: rift-cli execute display move-window --direction left
fn+ctrl+shift-j: rift-cli execute display move-window --direction down
fn+ctrl+shift-k: rift-cli execute display move-window --direction up
fn+ctrl+shift-l: rift-cli execute display move-window --direction right

fn-f: rift-cli execute window toggle-fullscreen

fn-s: rift-cli execute layout toggle-stack
fn-e: rift-cli execute layout toggle-orientation
fn-w: rift-cli execute layout toggle-stack
fn+shift-space: rift-cli execute window toggle-float
fn+shift-t: rift-cli execute space toggle-activated

fn-1: rift-cli execute workspace switch 0
fn-2: rift-cli execute workspace switch 1
fn-3: rift-cli execute workspace switch 2
fn-4: rift-cli execute workspace switch 3
fn-5: rift-cli execute workspace switch 4
fn-6: rift-cli execute workspace switch 5
fn-7: rift-cli execute workspace switch 6
fn-8: rift-cli execute workspace switch 7
fn-9: rift-cli execute workspace switch 8
fn-0: rift-cli execute workspace switch 9

fn+shift-1: rift-cli execute workspace move-window 0
fn+shift-2: rift-cli execute workspace move-window 1
fn+shift-3: rift-cli execute workspace move-window 2
fn+shift-4: rift-cli execute workspace move-window 3
fn+shift-5: rift-cli execute workspace move-window 4
fn+shift-6: rift-cli execute workspace move-window 5
fn+shift-7: rift-cli execute workspace move-window 6
fn+shift-8: rift-cli execute workspace move-window 7
fn+shift-9: rift-cli execute workspace move-window 8
fn+shift-0: rift-cli execute workspace move-window 9

fn+ctrl-h: rift-cli execute display move-workspace --wrap-around --direction left
fn+ctrl-l: rift-cli execute display move-workspace --wrap-around --direction right
fn+ctrl-j: rift-cli execute display move-workspace --wrap-around --direction down
fn+ctrl-k: rift-cli execute display move-workspace --wrap-around --direction up

fn-n: rift-cli execute workspace next
fn-p: rift-cli execute workspace prev
fn-tab: rift-cli execute workspace next
fn+shift-tab: rift-cli execute workspace prev


:: resize @
fn-r ; resize
resize < h : rift-cli execute window resize-shrink
resize < l : rift-cli execute window resize-grow
resize < j : rift-cli execute window resize-grow --orientation vertical
resize < k : rift-cli execute window resize-shrink --orientation vertical
resize < return ; default
resize < escape ; default


fn-d: open -a "Raycast" -g
